# ============================================================
# Zentox Aesthetics CRM — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# App
DEBUG=false

# Airtable (REQUIRED)
# Get your token from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appkI2SpAMNfCBvSo

# JWT (HIPAA) — use a 256-bit random string in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal API key (Streamlit → FastAPI)
INTERNAL_API_KEY=change-me-in-production

# CORS — set to your Hostinger domain
ALLOWED_ORIGINS=https://crm.zentoxaesthetics.com,http://localhost:8501

# AestheticsPro (optional)
AESTHETICSPRO_API_URL=https://api.aestheticspro.com
AESTHETICSPRO_API_KEY=

# GetWeave (optional)
GETWEAVE_API_KEY=
GETWEAVE_LOCATION_ID=

# QuickBooks Online (optional)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_SANDBOX=false

# Anthropic (AI Agents — Claude Haiku)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# SMTP (for agent email reports to info@fivezero3.net)
# Gmail example: enable 2FA and create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password

# Document storage (relative to project root)
UPLOAD_DIR=uploads/documents
